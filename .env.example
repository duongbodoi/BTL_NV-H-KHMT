# Mẫu tên biến môi trường. Code KHÔNG tự đọc file .env: đặt biến trong terminal (xem README,
# mục "Hướng dẫn chạy thử"). Không commit file chứa key thật.
# Provider đang dùng (configs/llm.yaml: provider: gemini, api_key_env: GEMINI_API_KEY)
GEMINI_API_KEY=
# Chỉ cần nếu nhóm đổi sang provider: anthropic
ANTHROPIC_API_KEY=
